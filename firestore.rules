rules_version = '2';

// Willow — Firestore security rules.
// Each user can read and write ONLY their own tracking data.
// Paste these into: Firebase console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Everything a user tracks lives under users/{uid}/...
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
